# ==============================================================================
# Secret — AWS / EKS (TEMPLATE)
# Variáveis substituídas no CI/CD pipeline via envsubst
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: billing-service-secret
  namespace: techchallenge
  labels:
    app.kubernetes.io/name: billing-service
    app.kubernetes.io/component: secret
    app.kubernetes.io/part-of: techchallenge
    app.kubernetes.io/environment: aws
type: Opaque
data:
  MercadoPago__AccessToken: "${MERCADO_PAGO_ACCESS_TOKEN_BASE64}"
  MercadoPago__WebhookSecret: "${MERCADO_PAGO_WEBHOOK_SECRET_BASE64}"
  MercadoPago__NotificationUrl: "${MERCADO_PAGO_NOTIFICATION_URL_BASE64}"
  # ConnectionString RDS (base64 encoded)
  ConnectionStrings__DefaultConnection: "${DB_CONNECTION_BASE64}"

---
apiVersion: v1
kind: Secret
metadata:
  name: dockerhub-secret
  namespace: techchallenge
  labels:
    app.kubernetes.io/name: billing-service
    app.kubernetes.io/component: secret
    app.kubernetes.io/part-of: techchallenge
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: "${DOCKER_CONFIG_JSON_BASE64}"
